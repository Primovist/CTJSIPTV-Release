# CTJSIPTV 1.0.0 配置示例
# 格式：KEY=VALUE
# 不需要的可选项保持为空即可。不要把包含真实账号/密码的配置提交到 Git。

# =============================================================================
# IPTV 认证（可选覆盖）
# =============================================================================

IPTV_USER_ID=
IPTV_PASSWORD=
IPTV_STB_ID=

# 三项全部填写时直接用于 Portal 认证，不调用 Zero Config。
# 未完整填写时，账号/密码仅作为 latestITVAccount/latestPwd 发送；Portal 认证使用
# Zero Config 返回的完整运行时身份，失败时回退 bootstrap.json 中最后一次成功身份。

# =============================================================================
# IPTV 网络身份（可选，但多网卡 / VPN / Surge 环境建议显式设置）
# =============================================================================

# IPTV 业务出口网卡。留空时尝试根据 itv.jsinfo.net 的系统路由自动判断。
NIC=en0

# IPTV 业务出口使用的 IPv4 留空时从 NIC 读取。
# IPTV_MAC 留空时优先复用 bootstrap.json 中的稳定软终端 MAC。无缓存时，
# 自动 Zero Config 模式生成并保存；完整显式凭据模式读取 NIC 的物理 MAC。
IPTV_MAC=
IPTV_IP=

# 官方 Zero Config 心跳。默认关闭；启用后按原 APK 每 30 秒发送一次。
# 需要 Zero Config 返回的 virtualAccount；仅配置 Portal 凭据且没有匹配的身份缓存时不会发送。
IPTV_HEARTBEAT_ENABLED=false

# =============================================================================
# 机顶盒认证扩展字段（可选）
# =============================================================================

# 通常保持为空。仅在实际认证环境要求时填写。
IPTV_STB_INFO=
IPTV_PRMID=
IPTV_DRM_SUPPLIER=

# Portal 认证后会尝试从 portal.properties 动态获取 API Key。
# 仅在确有需要时手工指定。
IPTV_API_KEY=
IPTV_SECRET_KEY=

# =============================================================================
# CTJSIPTV HTTP 服务
# =============================================================================

# 默认双栈监听 8765。
LISTEN=[::]:8765

# 管理接口远程访问白名单。留空时沿用 IPTV NIC 所在子网。
# 配置后只允许列出的 IPv4/IPv6 CIDR 访问管理接口；本机回环始终允许。
# 多个网段用逗号分隔，例如：192.168.2.0/24,fd00:2::/64
# 只填写可信网段；不要使用 0.0.0.0/0 或 ::/0，除非确实要允许所有地址。
MANAGEMENT_CIDRS=

# 通过域名、HTTPS 或反向代理访问时，建议设置统一公开根地址。
# 未设置时，请求响应使用请求 Host；后台/持久化链接使用 IPTV_IP/NIC 地址。
# 只能填写 http:// 或 https:// origin，不要附加路径、查询参数。
# 示例：https://iptv.example.com:444
PUBLIC_URL=

# =============================================================================
# 持久化数据
# =============================================================================

# 默认与本配置文件位于同一目录。相对路径也以配置目录为基准。
# 可单独设置到由 CTJSIPTV 运行用户拥有且可读写的目录。
DATA_DIR=

# 留空时分别使用 DATA_DIR/bootstrap.json、DATA_DIR/session-cookies.txt、
# DATA_DIR/channel-cache.json、DATA_DIR/epg-cache.json。
# 单项配置为相对路径时，始终以本配置文件所在目录为基准，不受 DATA_DIR 影响。
IPTV_BOOTSTRAP_CACHE=
# 仅保留一个活动 Cookie 文件；过期 Cookie 和超过 24 小时的旧版 Cookie 文件自动清理。
IPTV_COOKIE_FILE=
# 官方客户端档案保存 APK 版本与 Zero Config 请求体中的设备字段。
# 留空默认 DATA_DIR/official-client.json；首次启动自动创建。
IPTV_OFFICIAL_CLIENT_PROFILE=
# 最近一次官方 APK 检查结果；留空默认 DATA_DIR/official-apk-status.json。
IPTV_OFFICIAL_APK_STATUS=
LIVE_CHANNEL_CACHE=
EPG_CACHE=
# 全局 VOD 身份与稳定播放映射文件。留空默认 DATA_DIR/vod-catalog.json。
VOD_CATALOG=

# 运营商图片代理的本地缓存目录。留空默认 DATA_DIR/image-cache。
IMAGE_CACHE_DIR=

# =============================================================================
# 播放输出
# =============================================================================

# rtp2httpd HTTP/HTTPS 根地址。
# 可选。配置后，点播、TVBox 点播以及 Xtream VOD/Series 按现有策略使用代理地址。
# Xtream / TVBox 直播是否转发由下方 LIVE_OUTPUT_MODE 选择；原生直播 API 的转发地址仍见 /api/live/{rtp,http}/rtp2httpd。
# 示例：https://rtp2httpd.example.com:444
RTP2HTTPD=
# Xtream 与 TVBox 的直播地址模式：
# unicast=单播（HTTP/HTTPS）；multicast=组播（RTP/UDP）。默认单播。
# 配置 RTP2HTTPD 后可选 unicast-forwarded=单播·转发、multicast-forwarded=组播·转发。
# 未配置 RTP2HTTPD 时，网页设置会隐藏转发选项，遗留转发值自动回退到对应直连模式。
LIVE_OUTPUT_MODE=unicast

# 本地频道 Logo 目录。留空默认使用配置文件同目录下的 Logo/ 文件夹；相对路径也以配置文件目录为基准。
# 对应 PNG 存在时优先通过 /logo/<filename>.png 提供，否则回退到上游台标。
LIVE_LOGO_DIR=

# 直播源管理文件。相对路径以 ctjsiptv.conf 所在目录为基准。
# 留空默认：同目录 live-overrides.json
# JSON 结构：{"disabled":[],"order":[],"custom":[]}
LIVE_OVERRIDES=

# =============================================================================
# VOD
# =============================================================================

# VOD 标题清理规则。相对路径以 ctjsiptv.conf 所在目录为基准。
# 留空默认：同目录 vod-title-clean.json
# JSON 结构：{"literal":[],"suffix":[],"regex":[]}
VOD_TITLE_CLEAN_RULES=
STRM_ENABLED=false
STRM_OUTPUT_DIR=
STRM_NAMING_MODE=standard

# =============================================================================
# Xtream Codes
# =============================================================================

XTREAM_ENABLED=false

# 启用 Xtream 后必须设置。请使用独立强密码，不要复用 IPTV_PASSWORD。
XTREAM_USERNAME=
XTREAM_PASSWORD=

# =============================================================================
# TVBox / MacCMS
# =============================================================================

# 启用 TVBox 配置、MacCMS API 与播放路由；默认关闭。
TVBOX_ENABLED=false
